# Copy to backend/.env and fill in real values. Never commit .env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
BACKEND_PORT=3000

# Fingerprint templates live in a local Postgres (not Supabase) -- the
# GT-521Fx2 template bytes never leave this machine.
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=lifelink
LOCAL_DB_USER=lifelink
LOCAL_DB_PASSWORD=
TEMPLATE_ENCRYPTION_KEY=

# Set to 1 only for local development (enables the Werkzeug debugger)
FLASK_DEBUG=0

# Local iris engine (iris-module/engine/iris_service.py)
IRIS_ENGINE_URL=http://127.0.0.1:8010

# Per-device keys, sent by each device as X-API-Key. The ESP32's must equal
# API_KEY in fingerprint-device/firmware/config.py; the camera's is asked
# for by iris-module/camera-client/install_pizero.sh. Generate each with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
DEVICE_API_KEYS=dev-esp32-1:,iris-cam-1:
# Which camera device ids exist (they may not use fingerprint routes).
CAMERA_DEVICE_IDS=iris-cam-1
# Who may use the GUI and its API (default: this machine only).
GUI_ALLOWED_NETS=127.0.0.0/8,::1/128
# Supabase request timeout; patients viewed before stay readable offline.
SUPABASE_TIMEOUT_SECONDS=6
